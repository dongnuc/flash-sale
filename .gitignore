# Shared rules for the whole repository.
# backend/, frontend/ and tests/ add their own rules below this level.

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# IDE state and editor backups
.vs/
.idea/
.history/
*.suo
*.user
*.userosscache
*.sln.docstates
*.swp
*.swo
*~

# Local environment files; keep templates versioned
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Temporary files and logs
*.log
*.tmp
*.temp

# Common test coverage output
coverage/
.nyc_output/
